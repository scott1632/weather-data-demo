POSTGRES_USER=weather_user
POSTGRES_PASSWORD=weather_password
POSTGRES_DB=weather_db

POSTGRES_HOST=postgres
POSTGRES_PORT=5432

OPEN_METEO_LATITUDE=51.5000
OPEN_METEO_LONGITUDE=-0.1200
OPEN_METEO_TIMEZONE=Europe/London

CLOUDBEAVER_PORT=8978
STREAMLIT_PORT=8501
DBT_DOCS_PORT=8082
AIRFLOW_PORT=8088

# Airflow needs a stable secret key across restarts (session signing) and a
# default admin user created once at init -- change these for anything
# beyond local development.
AIRFLOW_WEBSERVER_SECRET_KEY=change-me-for-anything-beyond-local-dev
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin

